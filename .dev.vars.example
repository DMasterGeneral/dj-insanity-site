# Server variables for Pages Functions during local development.
# Copy to .dev.vars (git-ignored); `npm run dev:functions` (wrangler pages dev) reads it.
# Production and preview values are set in Cloudflare Pages -> Settings -> Variables and Secrets.
# Every function degrades cleanly when its variable is missing, so leave unused ones blank.
# Use DEV / test credentials only - never the production Firebase project or live Stripe keys.

# Firebase service-account JSON key, on one line (Firestore access for the functions)
FIREBASE_SERVICE_ACCOUNT=

# Stripe, TEST mode only: a restricted key (rk_test_...) with Checkout Sessions: Write, and the
# webhook endpoint's signing secret (whsec_...; `stripe listen` prints one for local work).
# Tips stay hidden unless both are set, settings/public.tipsEnabled is on, and the front end was
# built with VITE_STRIPE_PUBLISHABLE_KEY (.env.local).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend API key for booking emails, and the address that receives them
RESEND_API_KEY=
NOTIFY_EMAIL_TO=

# Turnstile secret. This is Cloudflare's always-pass TEST secret; the matching test site key
# 1x00000000000000000000AA goes in .env.local as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Salt for hashing visitor IPs / client IDs (any long random string). A fixed dev salt is used if blank.
HASH_SALT=

# Optional: ntfy topic URL or Telegram bot URL for push alerts (off when blank)
PUSH_URL=
