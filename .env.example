# Front-end (build-time) variables. Vite exposes only names starting with VITE_ to the browser,
# so nothing secret belongs here. Server secrets go in .dev.vars (see .dev.vars.example).
#
# Local values go in .env.local (git-ignored). They must point at the DEV Firebase project,
# never production. Production and preview values are set in Cloudflare Pages -> Settings ->
# Variables and Secrets.

# Firebase web config: https://console.firebase.google.com > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Stripe publishable key (test mode): https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Cloudflare Turnstile site key. For local work use Cloudflare's always-pass test key:
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
